rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Batches collection
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Daily logs collection
    match /dailyLogs/{logId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Feed inventory collection
    match /feedInventory/{feedId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Egg collections
    match /eggCollections/{collectionId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Health and vaccination logs
    match /healthLogs/{logId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Sales
    match /sales/{saleId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }
  }
}
